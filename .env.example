# Variables the worker reads. Job 4 receives events and sends e-mail: no database. It holds a service token only to read the content of a customer notice.
# The SMTP server. In development it is Mailpit, which captures every e-mail and sends none (ADR-004 D3).
SMTP_HOST=mailpit
SMTP_PORT=1025
# one platform address; the visible name of the sender is the tenant's
SMTP_FROM=no-reply@multitour.local
# both or neither; the password is a secret of the environment, never versioned
SMTP_USER=
SMTP_PASSWORD=
# DEVELOPMENT ONLY. Outside development leave it unset (TLS is then required): never copy this line to qa or main
SMTP_REQUIRE_TLS=false
SMTP_TIMEOUT=10s
# where /health listens
HTTP_ADDR=:8080
# The public key of the security service (PEM) on one line, line breaks written as backslash-n; or JWT_PUBLIC_KEY_FILE with a path (running the binary by hand; deploy/compose.yml passes only the inline key).
# The worker checks the token of every call itself; it never holds the private key.
JWT_PUBLIC_KEY=
JWT_ISSUER=multi-tour-security
JWT_AUDIENCE=multi-tour
# HU-COM-015: where job 4 reads the content of a customer notice (scheme, host and port only) and the SERVICE token it reads with
# (docker compose: multi-tour-infra-postgres/scripts/dev-token.sh worker-notifications). Both or neither; the token is a secret of the environment, never versioned.
COMMERCIAL_RESERVATION_BASE_URL=
SERVICE_TOKEN=
